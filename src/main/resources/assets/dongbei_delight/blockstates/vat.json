{
  "multipart": [
    {
      "apply": {
        "model": "dongbei_delight:block/vat"
      }
    },
    {
      "when": { "water_level": "1", "fermented": "false" },
      "apply": { "model": "dongbei_delight:block/vat_water1" }
    },
    {
      "when": { "water_level": "2", "fermented": "false" },
      "apply": { "model": "dongbei_delight:block/vat_water2" }
    },
    {
      "when": { "water_level": "3", "fermented": "false" },
      "apply": { "model": "dongbei_delight:block/vat_water3" }
    }
  ]
}
