{
  "multipart": [
    {
      "apply": {
        "model": "chinese_regional_culinary_ingredients:block/vat"
      }
    },
    {
      "when": { "water_level": "1" },
      "apply": { "model": "chinese_regional_culinary_ingredients:block/vat_water1" }
    },
    {
      "when": { "water_level": "2" },
      "apply": { "model": "chinese_regional_culinary_ingredients:block/vat_water2" }
    },
    {
      "when": { "water_level": "3" },
      "apply": { "model": "chinese_regional_culinary_ingredients:block/vat_water3" }
    }
  ]
}
